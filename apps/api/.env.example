# Copy to .env and adjust. Uses the local Postgres on :5432 (the machine's running
# instance). Field geometry is stored as JSONB for now; on AWS RDS with PostGIS
# enabled this becomes a real geometry column (see docs/adr/0001-geometry-storage.md).
AGRISMART_DATABASE_URL=postgresql+psycopg2://localhost:5432/agrismart
# Change this in any non-local environment.
AGRISMART_JWT_SECRET=dev-insecure-change-me
AGRISMART_JWT_EXPIRE_MINUTES=10080
# Comma-separated origins allowed to call the API (the web app in dev).
AGRISMART_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
